  #   home/user/.dir/file2
  #   home/user/.dir/subdir/file
  #   home/user/.local/share/chezmoi/exact_dot_dir/file1

  Scenario: apply --dry-run does not remove entries from exact directories
    When I run "apply --dry-run --force"
    Then it succeeds
    And "~/.dir/file1" exists
    And "~/.dir/file2" exists
    And "~/.dir/subdir/file" exists

  Scenario: apply removes entries from exact directories
    When I run "apply --force"
    Then it succeeds
